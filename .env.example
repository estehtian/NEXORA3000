# Supabase project URL and publishable key. These are intended for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets, if later required. NEVER prefix these with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
